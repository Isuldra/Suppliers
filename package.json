{
  "name": "one-med-supplychain-app",
  "version": "1.5.3",
  "description": "Pulse - Desktop application for managing supplier workflows and data",
  "main": "dist/main/main.cjs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/ensure-electron-modules.js && cross-env NODE_ENV=development electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "typecheck": "tsc --noEmit",
    "quality": "npm run format:check && npm run lint && npm run typecheck && npm run test -- --run --passWithNoTests",
    "quality:fix": "npm run format && npm run lint -- --fix && npm run typecheck",
    "quality:fast": "npm run format:check && npm run lint && npm run typecheck",
    "ci:check": "npm run quality",
    "start": "electron-vite preview",
    "test": "vitest",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "pack": "electron-builder --dir",
    "create-minimal-manifest": "node scripts/create-minimal-manifest.js",
    "dist": "electron-vite build && npm run create-minimal-manifest && electron-builder --win --publish never && npm run release:prepare",
    "dist:clean": "node scripts/build-with-version.js",
    "dist:win": "electron-vite build && npm run create-minimal-manifest && electron-builder --win --publish never",
    "dist:portable": "electron-vite build && npm run create-minimal-manifest && electron-builder --win portable --publish never",
    "dist:msi": "electron-vite build && npm run create-minimal-manifest && electron-builder --win msi --publish never",
    "dist:nsis": "electron-vite build && npm run create-minimal-manifest && electron-builder --win nsis --publish never",
    "release": "npm run validate:version && npm run dist:clean && npm run release:prepare && npm run release:github",
    "test-sqlite": "node scripts/test-sqlite-dependencies.js",
    "prepare-deps": "electron-builder install-app-deps",
    "deploy:cloudflare": "node scripts/simple-cloudflare-deploy.js",
    "version:sync": "node scripts/sync-version.js sync",
    "version:bump": "node scripts/sync-version.js bump",
    "version:bump:minor": "node scripts/sync-version.js bump minor",
    "version:bump:major": "node scripts/sync-version.js bump major",
    "version:bump:push": "node scripts/sync-version.js bump --push",
    "version:info": "node scripts/sync-version.js info",
    "version:help": "node scripts/sync-version.js help",
    "security-check": "bun audit --audit-level=moderate",
    "security-audit": "bun audit --audit-level=moderate",
    "release:prepare": "node scripts/prepare-cloudflare-release.js",
    "release:github": "node scripts/create-github-release.js",
    "release:full": "npm run validate:version && npm run dist:clean && npm run release:prepare && npm run release:github",
    "validate:version": "node scripts/validate-version.js",
    "validate:release": "node scripts/validate-release.js"
  },
  "build": {
    "appId": "com.onemed.supplychain",
    "productName": "Pulse",
    "copyright": "Copyright © 2024 OneMed",
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/build/Release/better*.node"
    ],
    "files": [
      "**/*"
    ],
    "npmRebuild": true,
    "directories": {
      "buildResources": "resources",
      "output": "release",
      "app": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "Isuldra",
      "repo": "Suppliers"
    },
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/pulse.ico",
      "artifactName": "${productName}-${version}-setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable.exe",
      "requestExecutionLevel": "user"
    },
    "msi": {
      "artifactName": "${productName}-${version}-Setup.msi",
      "oneClick": false,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pulse",
      "upgradeCode": "7C04A11D-9FAA-4B83-85FF-79D2AABFD84E"
    },
    "nsis": {
      "differentialPackage": false,
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": false,
      "installerIcon": "resources/pulse.ico",
      "uninstallerIcon": "resources/pulse.ico",
      "installerHeaderIcon": "resources/pulse.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pulse",
      "deleteAppDataOnUninstall": false,
      "displayLanguageSelector": true,
      "include": "resources/installer.nsh",
      "warningsAsErrors": false,
      "installerLanguages": [
        "nb_NO",
        "en_US"
      ]
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@octokit/rest": "^22.0.0",
    "@rollup/plugin-commonjs": "^28.0.6",
    "@tailwindcss/forms": "^0.5.7",
    "@testing-library/jest-dom": "^6.6.3",
    "@types/node": "^24.0.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@typescript-eslint/eslint-plugin": "^8.34.1",
    "@typescript-eslint/parser": "^8.34.1",
    "@vitejs/plugin-react": "^4.5.2",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.4.17",
    "cross-env": "^7.0.3",
    "electron": "^41.10.7",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.1.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "execa": "^9.5.2",
    "globals": "^16.2.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.28",
    "prettier": "^3.6.2",
    "rollup-plugin-copy": "^3.5.0",
    "semver": "^7.6.3",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.1",
    "vite": "^6.4.3",
    "vitest": "^4.1.11",
    "@types/better-sqlite3": "^7.6.13"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "better-sqlite3": "^12.11.1",
    "date-fns": "^4.1.0",
    "electron-log": "^5.4.1",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "i18next": "^25.6.0",
    "i18next-browser-languagedetector": "^8.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-dropzone": "^14.3.8",
    "react-hot-toast": "^2.5.2",
    "react-i18next": "^16.1.4",
    "react-router-dom": "^7.18.4",
    "recharts": "^2.15.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.2/xlsx-0.20.2.tgz"
  },
  "overrides": {
    "@types/minimatch": "5.1.2",
    "electron-builder": "^26.15.3",
    "functions-have-names": "1.2.3",
    "queue-microtask": "1.2.3",
    "uuid": "11.1.1"
  },
  "optionalDependencies": {
    "@rollup/rollup-win32-x64-msvc": "^4.44.0"
  }
}
